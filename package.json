{
  "name": "drone404",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.18.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @drone404/web dev",
    "dev:api": "pnpm --filter @drone404/api dev",
    "dev:sim": "pnpm --filter @drone404/drone-sim dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "db:generate": "pnpm --filter @drone404/database generate",
    "db:migrate": "pnpm --filter @drone404/database migrate",
    "db:seed": "pnpm --filter @drone404/database seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.5.6",
    "typescript-eslint": "^8.70.0"
  }
}